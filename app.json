{
  "expo": {
    "name": "LumaLive",
    "slug": "luma-live",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lumalive",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#101114",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101114"
      },
      "package": "com.lumalive.prototype"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {},
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1825a4f7-4261-44fa-a8e4-7814a9229e4d"
      }
    }
  }
}
